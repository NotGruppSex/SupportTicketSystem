<Page
    x:Class="SupportTicketSystem.Presentation.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SupportTicketSystem.Domain.Features.TicketRegistration.TicketRegistrationModels">

    <ScrollViewer>
        <Grid Padding="30"
              RowSpacing="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Overview"
                       Style="{StaticResource MainHeadingStyle}"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <Grid Grid.Row="1" ColumnSpacing="12">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="8">
                        <TextBlock Text="New"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusCounts.New, Mode=OneWay}"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="8">
                        <TextBlock Text="Ongoing"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusCounts.InProgress, Mode=OneWay}"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                    <StackPanel Spacing="8">
                        <TextBlock Text="Closed"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusCounts.Resolved, Mode=OneWay}"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Width="800"
                         HorizontalAlignment="Stretch"
                         PlaceholderText="Enter customer name or ticket title..."
                         Text="{x:Bind ViewModel.SearchText,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}">

                    <TextBox.Header>
                        <TextBlock Text="Search tickets"
                                   Style="{StaticResource SubHeadingStyle}"/>
                    </TextBox.Header>

                </TextBox>

                <ComboBox Grid.Column="1"
                          x:Name="StatusFilter"
                          Width="200"
                          HorizontalAlignment="Left"
                          SelectionChanged="StatusFilter_SelectionChanged">

                    <ComboBox.Header>
                        <TextBlock Text="Filter for status"
                                   Style="{StaticResource SubHeadingStyle}"/>
                    </ComboBox.Header>

                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="New"/>
                    <ComboBoxItem Content="Ongoing"/>
                    <ComboBoxItem Content="Closed"/>

                </ComboBox>

                <Button Grid.Column="2"
                        Style="{StaticResource PageButtonStyle}"
                        Content="Search"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.SearchCommand}"/>

            </Grid>

            <TextBlock Grid.Row="3"
                       Text="Tickets"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Style="{StaticResource MainHeadingStyle}"/>

            <SplitView Grid.Row="4"
                       DisplayMode="Inline"
                       PanePlacement="Right"
                       OpenPaneLength="350"
                       MaxHeight="500"
                       VerticalAlignment="Top"
                       IsPaneOpen="{x:Bind ViewModel.IsDetailsOpen, Mode=TwoWay}">

                <SplitView.Pane>
                    <ScrollViewer>
                        <StackPanel Padding="40"
                                    Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Details"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="1"
                                        Command="{x:Bind ViewModel.CloseDetailsCommand}"
                                        ToolTipService.ToolTip="Close details">
                                    <SymbolIcon Symbol="Cancel"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="Description" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedTicket.TicketDescription, Mode=OneWay}" TextWrapping="Wrap"/>

                            <TextBlock Text="Ticket ID" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedTicket.TicketID, Mode=OneWay}" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedTicket.TicketComments, Mode=OneWay}">
                                
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </SplitView.Pane>
                <SplitView.Content>
                    <ListView ItemsSource="{x:Bind ViewModel.Tickets, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTicket, Mode=TwoWay}"
                              SelectionMode="Single"
                              VerticalAlignment="Top"
                              VerticalContentAlignment="Top">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TicketModel">
                                <Border Padding="16"
                                        Height="250"
                                        Margin="0,4"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{x:Bind TicketTitle}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="WrapWholeWords"/>

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="70">

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Status"
                                                           Opacity="0.6"/>
                                                <TextBlock Text="{x:Bind TicketStatus}"/>
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Priority"
                                                           Opacity="0.6"/>
                                                <TextBlock Text="{x:Bind Priority}"/>
                                            </StackPanel>

                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Created"
                                                           Opacity="0.6"/>
                                                <TextBlock Text="{x:Bind TicketCreationDate}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid ColumnSpacing="20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Customer"
                                                           Opacity="0.6"/>
                                                <TextBlock Text="{x:Bind CustomerTicket.Name}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Assigned Agent"
                                                           Opacity="0.6"/>
                                                <TextBlock Text="{x:Bind TechnichianAssigned}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </SplitView.Content>
            </SplitView>
        </Grid>
    </ScrollViewer>
</Page>
