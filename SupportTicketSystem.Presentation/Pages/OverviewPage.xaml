<Page
    x:Class="SupportTicketSystem.Presentation.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SupportTicketSystem.Domain.Features.TicketRegistration.TicketRegistrationModels">

    <ScrollViewer>
        <StackPanel Padding="30" Spacing="20">

            <StackPanel Spacing="5">
                <TextBlock Text="Overview"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Search and handling"
                           Opacity="0.7"/>
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Nya ärenden"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusCounts.New, Mode=OneWay}"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Inprogress"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusCounts.InProgress, Mode=OneWay}"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="20"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Lösta"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusCounts.Resolved, Mode=OneWay}"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Header="Sök ärenden"
                         PlaceholderText="Enter customer name or ticket title..."
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Column="1"
                          x:Name="StatusFilter"
                          Header="Filter for status"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="StatusFilter_SelectionChanged">
                    <ComboBoxItem Content="Alla"/>
                    <ComboBoxItem Content="Nytt"/>
                    <ComboBoxItem Content="Pågående"/>
                    <ComboBoxItem Content="Löst"/>
                </ComboBox>

                <Button Grid.Column="2"
                        Content="Search"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.SearchCommand}"/>
            </Grid>

            <TextBlock Text="Tickets"
                       FontSize="20"
                       FontWeight="SemiBold"/>

            <ListView ItemsSource="{x:Bind ViewModel.Tickets, Mode=OneWay}"
                      SelectionMode="None">

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TicketModel">

                        <Border Padding="16"
                                Margin="0,4"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                            <StackPanel Spacing="12">

                                <TextBlock Text="{x:Bind TicketTitle}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="20">

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Status"
                                                   Opacity="0.6"/>
                                        <TextBlock Text="{x:Bind TicketStatus}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Prioritet"
                                                   Opacity="0.6"/>
                                        <TextBlock Text="{x:Bind Priority}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Skapad"
                                                   Opacity="0.6"/>
                                        <TextBlock Text="{x:Bind TicketCreationDate}"/>
                                    </StackPanel>

                                </StackPanel>

                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="Kund"
                                                   Opacity="0.6"/>
                                        <TextBlock Text="{x:Bind CustomerTicket.Name}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Handläggare"
                                                   Opacity="0.6"/>
                                        <TextBlock Text="{x:Bind TechnichianAssigned}"/>
                                    </StackPanel>
                                </Grid>

                                <Expander Header="Show details">
                                    <StackPanel Spacing="12"
                                                Padding="0,12,0,0">

                                        <TextBlock Text="Beskrivning"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{x:Bind TicketDescription}"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="Ticket-ID"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock Text="{x:Bind TicketID}"/>

                                        <TextBlock Text="Comments"
                                                   FontWeight="SemiBold"/>

                                        <ItemsControl ItemsSource="{x:Bind TicketComments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </Border>

                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
