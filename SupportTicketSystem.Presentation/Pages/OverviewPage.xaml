<Page
    x:Class="SupportTicketSystem.Presentation.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportTicketSystem.Presentation.Pages"
    xmlns:models="using:SupportTicketSystem.Domain.Features.TicketRegistration.TicketRegistrationModels">

    <ScrollViewer>
        <StackPanel Padding="30" Spacing="20">

            <TextBlock Text="Ärendeöversikt"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBox Header="Sök ärenden"
                     PlaceholderText="Sök efter ärenderubrik eller kundnamn"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <ComboBox x:Name="StatusFilter"
                      Header="Filtrera efter status"
                      MinWidth="200"
                      SelectionChanged="StatusFilter_SelectionChanged">
                <ComboBoxItem Content="Alla"/>
                <ComboBoxItem Content="Nytt"/>
                <ComboBoxItem Content="Pågående"/>
                <ComboBoxItem Content="Löst"/>
            </ComboBox>

            <Button Content="Sök"
                    Command="{x:Bind ViewModel.SearchCommand}"/>

            <TextBlock Text="Ärenden"
                       FontSize="20"
                       FontWeight="SemiBold"/>

            <ListView ItemsSource="{x:Bind ViewModel.Tickets, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TicketModel">
                        <StackPanel Padding="10" Spacing="5">
                            <TextBlock Text="{x:Bind TicketTitle}"
                                       FontWeight="SemiBold"/>

                            <TextBlock Text="{x:Bind TicketStatus}"/>

                            <TextBlock Text="{x:Bind TicketCreationDate}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</Page>
