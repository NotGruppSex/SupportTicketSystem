<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="SupportTicketSystem.Presentation.Pages.TicketEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportTicketSystem.Presentation.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="30">

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">

            <!-- Formuläret får extra utrymme till höger för scrollbaren -->
            <StackPanel Spacing="16"
                        Margin="0,0,20,0">

                <!-- Sidans rubrik och ärendets ID -->
                <StackPanel Spacing="4">

                    <TextBlock Text="Ticket details"
                               FontSize="28"
                               FontWeight="Bold" />

                    <TextBlock Text="{x:Bind ViewModel.TicketID, Mode=OneWay}"
                               FontSize="14"
                               Foreground="Gray" />

                </StackPanel>

                <!-- Kund -->
                <StackPanel Spacing="4">

                    <TextBlock Text="Customer"
                               FontWeight="SemiBold" />

                    <TextBlock Text="{x:Bind ViewModel.CustomerName, Mode=OneWay}" />

                </StackPanel>

                <!-- Rubrik -->
                <StackPanel Spacing="4">

                    <TextBlock Text="Title"
                               FontWeight="SemiBold" />

                    <TextBox Text="{x:Bind ViewModel.Title, Mode=TwoWay}"
                             PlaceholderText="Ticket title"
                             HorizontalAlignment="Stretch" />

                </StackPanel>

                <!-- Beskrivning -->
                <StackPanel Spacing="4">

                    <TextBlock Text="Description"
                               FontWeight="SemiBold" />

                    <TextBox Text="{x:Bind ViewModel.Description, Mode=TwoWay}"
                             PlaceholderText="Ticket description"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="100"
                             HorizontalAlignment="Stretch" />

                </StackPanel>

                <!-- Prioritet -->
                <StackPanel Spacing="4">

                    <TextBlock Text="Priority"
                               FontWeight="SemiBold" />

                    <ComboBox ItemsSource="{x:Bind ViewModel.Priorities}"
                              SelectedItem="{x:Bind ViewModel.Priority, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />

                </StackPanel>

                <!-- Status och handläggare -->
                <Grid ColumnSpacing="16">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Status -->
                    <StackPanel Grid.Column="0"
                                Spacing="4">

                        <TextBlock Text="Status"
                                   FontWeight="SemiBold" />

                        <ComboBox ItemsSource="{x:Bind ViewModel.Statuses}"
                                  SelectedItem="{x:Bind ViewModel.Status, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />

                    </StackPanel>

                    <!-- Handläggare -->
                    <StackPanel Grid.Column="1"
                                Spacing="4">

                        <TextBlock Text="Technician"
                                   FontWeight="SemiBold" />

                        <ComboBox ItemsSource="{x:Bind ViewModel.Technichians}"
                                  SelectedItem="{x:Bind ViewModel.AssignedTechnichian, Mode=TwoWay}"
                                  PlaceholderText="Choose a technician"
                                  HorizontalAlignment="Stretch" />

                    </StackPanel>

                </Grid>

                <!-- Tidigare kommentarer -->
                <StackPanel Spacing="8">

                    <TextBlock Text="Comments"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,8,0,0" />

                    <ListView ItemsSource="{x:Bind ViewModel.Comments, Mode=OneWay}"
                              MaxHeight="300"
                              Padding="0"
                              HorizontalAlignment="Stretch">

                        <ListView.ItemTemplate>
                            <DataTemplate>

                                <!-- Litet indrag för kommentarernas innehåll -->
                                <StackPanel Spacing="4"
                                            Padding="8,8,0,8">

                                    <TextBlock Text="{Binding CommentText}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Text="{Binding CommentDate}"
                                               FontSize="12"
                                               Opacity="0.7" />

                                </StackPanel>

                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </StackPanel>

                <!-- Ny kommentar -->
                <StackPanel Spacing="4">

                    <TextBlock Text="New comment"
                               FontWeight="SemiBold" />

                    <TextBox Text="{x:Bind ViewModel.NewComment, Mode=TwoWay}"
                             PlaceholderText="Write a comment"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="80"
                             HorizontalAlignment="Stretch" />

                </StackPanel>

                <!-- Sparar alla ändringar -->
                <Button Content="Save changes"
                        Command="{x:Bind ViewModel.SaveTicketChangesCommand}"
                        Style="{StaticResource PageButtonStyle}"
                        HorizontalAlignment="Left" />

                <!-- Bekräftelse -->
                <TextBlock Text="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}"
                           Foreground="Green"
                           TextWrapping="Wrap" />

                <!-- Felmeddelande -->
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           Foreground="Red"
                           TextWrapping="Wrap" />

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>
