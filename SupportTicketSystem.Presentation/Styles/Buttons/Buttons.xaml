<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SupportTicketSystem.Presentation.Styles.Buttons">

<!--Style för vanliga buttons på sidorna. Rektangulära och testar annorlunda färg för skojsskull-->
    <Style x:Key="PageButtonStyle" TargetType="Button">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Background" Value="DarkSeaGreen"/>
        <Setter Property="Foreground" Value="Linen"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
</ResourceDictionary>
